# Local development environment variables for the Expo app.
# Copy this file to .env and adjust the URL for how you're running the app.
# Only EXPO_PUBLIC_-prefixed vars are exposed to the app bundle — never put
# secrets here, anything here ships inside the app binary.

# Base URL of the Go backend (see ../backend), no trailing slash.
#
# - Physical device via Expo Go / dev client: use your computer's LAN IP
#     (find it with `ipconfig getifaddr en0` on macOS), e.g. http://192.168.1.23:8080
# - iOS Simulator: http://localhost:8080 works (simulator shares the Mac's network stack)
# - Android Emulator: http://10.0.2.2:8080 (10.0.2.2 is the emulator's alias for the host)
#
# If unset, src/api/config.ts falls back to one of the above based on platform,
# but physical-device testing always requires setting this explicitly.
EXPO_PUBLIC_API_URL=http://localhost:8080
