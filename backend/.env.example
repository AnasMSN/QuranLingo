# Local development environment variables — DUMMY VALUES ONLY.
# This file is gitignored. Copy .env.example to .env and fill in real values per environment.
# Never commit real credentials here.

APP_ENV=development
APP_PORT=8080

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quranlingo
POSTGRES_PASSWORD=dummy_local_password
POSTGRES_DB=quranlingo
DATABASE_URL=postgres://quranlingo:dummy_local_password@localhost:5432/quranlingo?sslmode=disable

# --- Redis (cache/sessions/leaderboards, asynq job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=dummy_jwt_access_secret_change_me
JWT_REFRESH_SECRET=dummy_jwt_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Object storage (S3-compatible, e.g. MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quranlingo-assets
S3_ACCESS_KEY=dummy_access_key
S3_SECRET_KEY=dummy_secret_key

# --- Audio (per-word/question pronunciation clips) — NOT YET WIRED UP ---
# Simple path (no S3 SDK/credentials needed): host clips as public files
# anywhere and set this to that host's base URL. Easiest with Supabase
# Storage since you already have that project — Storage tab -> New bucket
# -> mark it Public -> its base URL looks like:
#   https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
# Each question would then only need a short filename (e.g. "allah.mp3")
# appended to this base URL. Any other public bucket/CDN works the same way.
AUDIO_BASE_URL=https://dummy-project-ref.supabase.co/storage/v1/object/public/audio

# --- Payments (fill in real test keys locally, never commit) ---
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy

# --- Admin panel (server-rendered login page + signed-cookie session at /admin) ---
# Leave any of these unset to disable the admin panel entirely (fails closed).
# Generate a hash with: make backend-admin-hash password=yourpassword
# Generate a session secret with: make backend-admin-secret
# IMPORTANT: single-quote the hash — it contains $ characters that a shell
# `source`/`. ./.env` (as used by the Makefile) would otherwise expand.
# There is no admin registration flow — this env-configured credential is the
# only admin account that can ever exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='dummy_bcrypt_hash_change_me'
ADMIN_SESSION_SECRET=dummy_64_char_hex_secret_change_me
